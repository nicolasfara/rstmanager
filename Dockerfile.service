ARG BUILD_IMAGE=sbtscala/scala-sbt:eclipse-temurin-25.0.3_9_1.12.13_3.3.8
ARG RUNTIME_IMAGE=eclipse-temurin:25.0.5_8-jre-jammy

FROM ${BUILD_IMAGE} AS build

WORKDIR /app

ENV SBT_OPTS="-Dsbt.supershell=false"

COPY build.sbt ./
COPY project ./project

RUN sbt -batch domain/update service/update

COPY domain/src/main ./domain/src/main
COPY service/src/main ./service/src/main

RUN sbt -batch service/assembly \
  && cp service/target/scala-*/rstmanager-service.jar /tmp/rstmanager-service.jar

FROM ${RUNTIME_IMAGE} AS runtime

WORKDIR /app

RUN useradd --create-home --uid 10001 appuser

COPY --from=build --chown=appuser:appuser /tmp/rstmanager-service.jar /app/rstmanager-service.jar

USER appuser

EXPOSE 8080

# Small, fixed footprint instead of the JVM's container-relative defaults: on
# Railway the container sees the plan's memory ceiling (GBs) and CPU count, and
# billing is per GB of RAM held, so ergonomic sizing reserves far more heap,
# GC/JIT threads and code cache than this low-traffic service needs.
#   SerialGC + fixed -Xmx     one GC thread, heap bounded and given back on full GCs
#   ActiveProcessorCount=2    sizes the cats-effect pool, GC and JIT threads
#   TieredStopAtLevel=1       C1 only: less JIT memory/CPU, ample for this load
#   UseCompactObjectHeaders   JDK 25: 8-byte headers, ~10-20% smaller live heap
#   ExitOnOutOfMemoryError    let Railway restart the service instead of limping
# Railway: override the whole set with the JDK_JAVA_OPTIONS service variable.
ENV JDK_JAVA_OPTIONS="-XX:+UseSerialGC -Xms64m -Xmx320m -Xss512k -XX:ReservedCodeCacheSize=48m -XX:TieredStopAtLevel=1 -XX:ActiveProcessorCount=2 -XX:+UseCompactObjectHeaders -XX:+ExitOnOutOfMemoryError"

ENTRYPOINT ["java", "-jar", "/app/rstmanager-service.jar"]
